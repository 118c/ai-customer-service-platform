# 企业员工智能客服环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=EnterpriseEmployeeService
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_API_KEY=
ADMIN_API_KEY=

# ── 主模型（留空时启用本地连续性提供器）───────────────────────────────────────
ANTHROPIC_API_KEY=

# 可选：兼容 Anthropic Messages 协议的服务地址与模型名称
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── OpenAI 兼容备用模型 ───────────────────────────────────────────────────────
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=deepseek-chat
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TRACE_REDIS_URL=redis://localhost:6379/2
TRACE_TTL_SECONDS=604800
REDIS_PASSWORD=change_this_before_deploy
LANGGRAPH_REDIS_URL=redis://:change_this_before_deploy@localhost:6379/1
LANGGRAPH_CHECKPOINT_TTL_MINUTES=1440

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
SERVICE_SKILLS_DIR=./skills
SERVICE_SKILLS_MAX_PROMPT_CHARS=5000

# ── 企业业务系统连接器 ────────────────────────────────────────────────────────
# 同时配置地址和令牌时切换到企业 HTTP 接口；否则使用本地参考服务。
ENTERPRISE_API_BASE_URL=
ENTERPRISE_API_TOKEN=
ENTERPRISE_API_TIMEOUT_SECONDS=5
REFERENCE_SERVICE_DB=./data/reference-services.db

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_before_deploy

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
